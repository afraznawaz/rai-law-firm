{
  "compilerOptions": {
    "tsBuildInfoFile": "/tmp/tsbuild/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/App.tsx", "src/App.css", "src/main.tsx", "src/index.css", "src/lib/**/*", "src/pages/Admin.tsx", "src/pages/BlogPost.tsx", "src/components/**/*", "src/assets/**/*"],
  "exclude": []
}
